{
    "name": "TabTree",
    "version": "0.5.1",
    "manifest_version": 3,
    "permissions": [
        "tabs",
        "sidePanel",
        "storage",
        "activeTab",
        "scripting"
    ],
    "description": "Organize open tabs into a searchable tree with on-device AI.",
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "side_panel": {
        "default_path": "sidebar/sidebar.html"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self';"
    },
    "action": {
        "default_title": "Expand TabTree",
        "default_icon": {
            "16": "icons/extension-icon16x16.png",
            "32": "icons/extension-icon32x32.png"
        }
    },
    "commands": {
        "_execute_action": {
            "suggested_key": { "default": "Alt+Shift+Y" }
        }
    },
    "web_accessible_resources": [
        {
            "resources": ["popup/popup.html"],
            "matches": ["http://*/*", "https://*/*"]
        }
    ],
    "icons": {
        "16": "icons/extension-icon16x16.png",
        "32": "icons/extension-icon32x32.png",
        "48": "icons/extension-icon48x48.png",
        "128": "icons/extension-icon128x128.png"
    }
}
